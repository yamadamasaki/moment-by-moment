{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "moment-by-moment",
  "main": "src/worker/index.tsx",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Only these paths reach the Worker; everything else is a static file.
    "run_worker_first": ["/admin", "/auth/*", "/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "moment-by-moment",
      "database_id": "0adb1249-5d8d-4ffd-ad2b-eeae2680698f",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // The public repo that holds content/. Fill these in.
    "GITHUB_OWNER": "yamadamasaki",
    "GITHUB_REPO": "moment-by-moment",
    "GITHUB_BRANCH": "master",
    // The only GitHub account allowed to write.
    "ALLOWED_USER": "yamadamasaki"
  }
  // Secrets (wrangler secret put): GITHUB_CLIENT_ID, GITHUB_CLIENT_SECRET, SESSION_SECRET
}
