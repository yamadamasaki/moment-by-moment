{
  "name": "moment-by-moment",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsx src/build/index.tsx",
    "dev": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.worker.json",
    "test": "vitest run",
    "gen:emoji": "tsx scripts/gen-emoji-index.ts",
    "db:migrate:local": "wrangler d1 migrations apply moment-by-moment --local",
    "db:migrate:remote": "wrangler d1 migrations apply moment-by-moment --remote"
  },
  "dependencies": {
    "hono": "^4.13.19"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261118.1",
    "@types/node": "^26.6.6",
    "emojibase-data": "^18.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.164.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261117.1": true
  }
}
